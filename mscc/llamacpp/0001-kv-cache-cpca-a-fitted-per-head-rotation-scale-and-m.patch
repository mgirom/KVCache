+        k_cur = llama_mul_mat_perhead(ctx0, k_cur, cpca->k_rot, cpca->k_bias);
+        v_cur = llama_mul_mat_perhead(ctx0, v_cur, cpca->v_rot, cpca->v_bias);
+    } else {
+        if (inp->self_k_rot) {
+            q_cur = llama_mul_mat_hadamard(ctx0, q_cur, inp->self_k_rot);
+            k_cur = llama_mul_mat_hadamard(ctx0, k_cur, inp->self_k_rot);
+        }
 
-    if (inp->self_v_rot) {
-        v_cur = llama_mul_mat_hadamard(ctx0, v_cur, inp->self_v_rot);
+        if (inp->self_v_rot) {
+            v_cur = llama_mul_mat_hadamard(ctx0, v_cur, inp->self_v_rot);
+        }
     }
 
     // these nodes are added to the graph together so that they are not reordered
@@ -2834,7 +2843,10 @@ ggml_tensor * llm_graph_context::build_attn(
     ggml_tensor * cur = build_attn_mha(q, k, v, kq_b, kq_mask, sinks, v_mla, kq_scale, il);
     cb(cur, "kqv_out", il);
 
-    if (inp->self_v_rot) {
+    if (cpca) {
+        // softmax weights sum to one, so the stored mean comes back exactly
+        cur = llama_mul_mat_perhead(ctx0, cur, cpca->v_unrot, cpca->v_mean);
+    } else if (inp->self_v_rot) {
         cur = llama_mul_mat_hadamard(ctx0, cur, inp->self_v_rot);
     }
 
diff --git a/src/llama-impl.h b/src/llama-impl.h
index 4988b06..d13d0dd 100644
--- a/src/llama-impl.h
+++ b/src/llama-impl.h
@@ -74,6 +74,33 @@ static inline ggml_tensor * llama_mul_mat_hadamard(
     return res;
 }
 
+// cpca: per-head matrix on every head of `cur`. rot is [d, d, H] (y = rot . x per head,
+// heads broadcast by division so query head h uses KV head h / groups, as K.Q does);
+// bias, if given, is [d, Hb] with Hb dividing the head count of `cur`. `cur` is
+// [d, n_head, n_tokens] or the flattened [d*n_head, n_tokens]; the result has cur's shape.
+static inline ggml_tensor * llama_mul_mat_perhead(
+        ggml_context * ctx,
+        ggml_tensor * cur,
+        ggml_tensor * rot,
+        ggml_tensor * bias) {
+    const int64_t d = rot->ne[0];
+    const int64_t n_tokens = cur->ne[ggml_n_dims(cur) - 1];
+    const int64_t nh = ggml_nelements(cur) / (d * n_tokens);
+    GGML_ASSERT(nh % rot->ne[2] == 0);
+    ggml_tensor * x = ggml_reshape_3d(ctx, ggml_cont(ctx, cur), d, nh, n_tokens);
+    x = ggml_cont(ctx, ggml_permute(ctx, x, 0, 2, 1, 3));              // [d, n_tokens, nh]
+    ggml_tensor * y = ggml_mul_mat(ctx, rot, x);                        // [d, n_tokens, nh]
+    y = ggml_cont(ctx, ggml_permute(ctx, y, 0, 2, 1, 3));              // [d, nh, n_tokens]
+    if (bias) {
+        GGML_ASSERT(nh % bias->ne[1] == 0);
+        y = ggml_add(ctx, y, bias);
+    }
+    if (ggml_n_dims(cur) == 2) {
+        return ggml_reshape_2d(ctx, y, d*nh, n_tokens);
+    }
+    return ggml_reshape_3d(ctx, y, d, nh, n_tokens);
+}
+
 struct time_meas {
     time_meas(int64_t & t_acc, bool disable = false);
     ~time_meas();
