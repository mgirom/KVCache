                 layers.push_back(layer_share);
                 layers.back().il = il;
@@ -242,6 +264,20 @@ llama_kv_cache::llama_kv_cache(
             v_stream.push_back(has_v ? ggml_view_2d(ctx, v, n_embd_v_gqa, kv_size, v->nb[1], s*v->nb[2]) : nullptr);
         }
 
+        if (has_cpca) {
+            const int64_t d  = hparams.n_embd_head_k(il);
+            const int64_t hk = hparams.n_head_kv(il);
+            const int64_t hq = hparams.n_head(il);
+            GGML_ASSERT(hparams.n_embd_head_v(il) == d && "cpca: K and V head dims must match");
+            auto & c = cpca_layers[il];
+            auto mk3 = [&](const char * nm) { auto * t = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d, d, hk); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
+            auto mk2 = [&](const char * nm, int64_t h) { auto * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, h); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
+            c.q_rot = mk3("q_rot");  c.k_rot = mk3("k_rot");  c.k_unrot = mk3("k_unrot");
+            c.v_rot = mk3("v_rot");  c.v_unrot = mk3("v_unrot");
+            c.k_bias = mk2("k_bias", hk); c.k_mean = mk2("k_mean", hk);
+            c.v_bias = mk2("v_bias", hk); c.v_mean = mk2("v_mean", hq);
+        }
+
         map_layer_ids[il] = layers.size();
 
         layers.push_back({ il, k, v, k_stream, v_stream, });
@@ -292,6 +328,41 @@ llama_kv_cache::llama_kv_cache(
         ctxs_bufs.emplace_back(std::move(ctx), buf);
     }
 
+    if (has_cpca) {
+        int n_set = 0;
+        for (uint32_t il = 0; il < hparams.n_layer(); ++il) {
+            if (map_layer_ids.find(il) == map_layer_ids.end()) {
+                continue;
+            }
+            auto & c = cpca_layers[il];
+            const std::pair<const char *, ggml_tensor *> want[] = {
+                {"q_rot", c.q_rot}, {"k_rot", c.k_rot}, {"k_bias", c.k_bias}, {"k_unrot", c.k_unrot},
+                {"k_mean", c.k_mean}, {"v_rot", c.v_rot}, {"v_bias", c.v_bias}, {"v_unrot", c.v_unrot},
+                {"v_mean", c.v_mean},
+            };
+            for (const auto & [nm, dst] : want) {
+                char name[128];
+                snprintf(name, sizeof(name), "blk.%d.cpca_%s", il, nm);
+                ggml_tensor * src = ggml_get_tensor(cpca_host, name);
+                if (!src) {
+                    throw std::runtime_error(std::string("cpca codebook is missing tensor ") + name);
+                }
+                if (ggml_nelements(src) != ggml_nelements(dst) || src->ne[0] != dst->ne[0] || src->ne[1] != dst->ne[1]) {
+                    throw std::runtime_error(std::string("cpca codebook tensor has the wrong shape for this model: ") + name);
+                }
+                if (src->type != GGML_TYPE_F32) {
+                    throw std::runtime_error(std::string("cpca codebook tensor must be f32: ") + name);
+                }
+                ggml_backend_tensor_set(dst, src->data, 0, ggml_nbytes(dst));
+                ++n_set;
+            }
+        }
+        gguf_free(cpca_gguf);
+        ggml_free(cpca_host);
+        cpca_gguf = nullptr; cpca_host = nullptr;
+        LLAMA_LOG_INFO("%s: cpca: %d tensors loaded onto the cache's buffers\n", __func__, n_set);
+    }
+
     {
         const size_t memory_size_k = size_k_bytes();
         const size_t memory_size_v = size_v_bytes();
@@ -1248,6 +1319,13 @@ uint32_t llama_kv_cache::get_n_kv(const slot_info & sinfo) const {
     return result;
 }
 
+const llama_kv_cache::cpca_layer * llama_kv_cache::get_cpca(int32_t il) const {
+    if (!has_cpca || il < 0 || (size_t) il >= cpca_layers.size() || !cpca_layers[il].k_rot) {
+        return nullptr;
+    }
+    return &cpca_layers[il];
+}
