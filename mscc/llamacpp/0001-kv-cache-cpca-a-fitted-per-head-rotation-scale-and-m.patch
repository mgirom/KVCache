 src/llama-impl.h       | 27 +++++++++++++
 src/llama-kv-cache.cpp | 92 ++++++++++++++++++++++++++++++++++++++++--
 src/llama-kv-cache.h   | 21 ++++++++++
 4 files changed, 156 insertions(+), 10 deletions(-)

