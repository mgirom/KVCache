diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 6cb6dbd..fa2b3d4 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -114,6 +114,23 @@ public:
         const  layer_reuse_cb & reuse,
         const  layer_share_cb & share);
 
+    // cpca: a data-fitted per-head rotation (with scale and mean) that replaces the
+    // Hadamard rotation of the quantised cache when LLAMA_KV_CODEBOOK names a GGUF.
+    // Every tensor is in the orientation ggml_mul_mat consumes: y = rot . x.
+    struct cpca_layer {
+        ggml_tensor * q_rot   = nullptr; // [d, d, n_head_kv]   V^T diag(s)
+        ggml_tensor * k_rot   = nullptr; // [d, d, n_head_kv]   V^T diag(1/s)
+        ggml_tensor * k_bias  = nullptr; // [d, n_head_kv]      -k_rot . mu
+        ggml_tensor * k_unrot = nullptr; // [d, d, n_head_kv]   diag(s) V
+        ggml_tensor * k_mean  = nullptr; // [d, n_head_kv]      mu
+        ggml_tensor * v_rot   = nullptr;
+        ggml_tensor * v_bias  = nullptr;
+        ggml_tensor * v_unrot = nullptr;
+        ggml_tensor * v_mean  = nullptr; // [d, n_head]         mu_v, pre-expanded to query heads
+    };
+
+    const cpca_layer * get_cpca(int32_t il) const;
+
     ~llama_kv_cache() = default;
 
     //
@@ -235,6 +252,7 @@ private:
         std::vector<ggml_tensor *> v_stream;
     };
 
+
     bool v_trans = true;  // the value tensor is transposed
 
     const uint32_t n_seq_max = 1;
@@ -248,6 +266,8 @@ private:
 
     // env: LLAMA_ATTN_ROT_DISABLE
