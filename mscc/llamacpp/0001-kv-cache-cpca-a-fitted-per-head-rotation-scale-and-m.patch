--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2798,13 +2798,22 @@ ggml_tensor * llm_graph_context::build_attn(
             int       il) const {
     GGML_ASSERT(v_mla == nullptr);
 
-    if (inp->self_k_rot) {
-        q_cur = llama_mul_mat_hadamard(ctx0, q_cur, inp->self_k_rot);
-        k_cur = llama_mul_mat_hadamard(ctx0, k_cur, inp->self_k_rot);
-    }
+    const auto * cpca = inp->mctx->get_cpca(il);
+    if (cpca) {
+        // fitted rotation with scale and mean in place of the Hadamard; the key-side
