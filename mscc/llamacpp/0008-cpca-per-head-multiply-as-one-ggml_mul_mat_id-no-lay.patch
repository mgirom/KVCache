--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -2802,9 +2802,9 @@ ggml_tensor * llm_graph_context::build_attn(
     if (cpca) {
         // fitted rotation with scale and mean in place of the Hadamard; the key-side
