+        // with ids[t][h] = h (K and V). A graph takes a view of the first n_tokens columns.
+        ggml_tensor * ids_q   = nullptr;
+        ggml_tensor * ids_kv  = nullptr;
     };
 
     const cpca_layer * get_cpca(int32_t il) const;
