From 686b6a64df182c4690cb6c9a99c32db717324c77 Mon Sep 17 00:00:00 2001
From: mgirom <84082110+mgirom@users.noreply.github.com>
Date: Wed, 2 Sep 2026 20:43:52 +0100
Subject: [PATCH 3/9] kv-cache: cpca helper infers layout from ne[0], not
 ggml_n_dims (breaks at n_tokens == 1)

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/llama-impl.h       | 11 ++++++++---
 src/llama-kv-cache.cpp | 41 ++++++++++++++++++++++++++++++++++++++---
 src/llama-kv-cache.h   |  1 +
 3 files changed, 47 insertions(+), 6 deletions(-)

diff --git a/src/llama-impl.h b/src/llama-impl.h
index d13d0dd..996efdb 100644
--- a/src/llama-impl.h
+++ b/src/llama-impl.h
@@ -84,8 +84,13 @@ static inline ggml_tensor * llama_mul_mat_perhead(
         ggml_tensor * rot,
         ggml_tensor * bias) {
     const int64_t d = rot->ne[0];
-    const int64_t n_tokens = cur->ne[ggml_n_dims(cur) - 1];
-    const int64_t nh = ggml_nelements(cur) / (d * n_tokens);
+    // two layouts reach here: [d, n_head, n_tokens] (q, k, v before the cache) and the
+    // flattened [d*n_head, n_tokens] attention output. ggml_n_dims() cannot tell them
+    // apart when n_tokens == 1, so decide by ne[0].
+    const bool per_head_layout = cur->ne[0] == d;
+    const int64_t nh       = per_head_layout ? cur->ne[1] : cur->ne[0] / d;
+    const int64_t n_tokens = per_head_layout ? cur->ne[2] : cur->ne[1];
+    GGML_ASSERT(cur->ne[0] * cur->ne[1] * cur->ne[2] * cur->ne[3] == d * nh * n_tokens);
     GGML_ASSERT(nh % rot->ne[2] == 0);
     ggml_tensor * x = ggml_reshape_3d(ctx, ggml_cont(ctx, cur), d, nh, n_tokens);
     x = ggml_cont(ctx, ggml_permute(ctx, x, 0, 2, 1, 3));              // [d, n_tokens, nh]
@@ -95,7 +100,7 @@ static inline ggml_tensor * llama_mul_mat_perhead(
         GGML_ASSERT(nh % bias->ne[1] == 0);
         y = ggml_add(ctx, y, bias);
     }
-    if (ggml_n_dims(cur) == 2) {
+    if (!per_head_layout) {
         return ggml_reshape_2d(ctx, y, d*nh, n_tokens);
     }
     return ggml_reshape_3d(ctx, y, d, nh, n_tokens);
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index e0e2e51..eb7fcfe 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -130,11 +130,33 @@ llama_kv_cache::llama_kv_cache(
         }
     }
 
+    // cpca tensors get their own contexts: the cache's contexts may be no_alloc (dummy
+    // buffers, data filled in by the scheduler later), but a codebook is a constant that
+    // must be resident before the first graph
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr> cpca_ctx_map;
+    auto cpca_ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = cpca_ctx_map.find(buft);
+        if (it == cpca_ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ size_t(9)*size_t(hparams.n_layer())*ggml_tensor_overhead(),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+            ggml_context * ctx = ggml_init(params);
+            if (!ctx) {
+                return nullptr;
+            }
+            cpca_ctx_map[buft] = ggml_context_ptr(ctx);
+            return ctx;
+        }
+        return it->second.get();
+    };
+
     auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
         auto it = ctx_map.find(buft);
         if (it == ctx_map.end()) {
             ggml_init_params params = {
-                /*.mem_size   =*/ (size_t(2u*(1 + n_stream)*n_layer*ggml_tensor_overhead())) + (has_cpca ? size_t(9)*size_t(hparams.n_layer())*ggml_tensor_overhead() : size_t(0)),
+                /*.mem_size   =*/ (size_t(2u*(1 + n_stream)*n_layer*ggml_tensor_overhead())),
                 /*.mem_buffer =*/ NULL,
                 /*.no_alloc   =*/ true,
             };
@@ -265,13 +287,17 @@ llama_kv_cache::llama_kv_cache(
         }
 
         if (has_cpca) {
+            ggml_context * cctx = cpca_ctx_for_buft(buft);
+            if (!cctx) {
+                throw std::runtime_error("failed to create ggml context for the cpca codebook");
+            }
             const int64_t d  = hparams.n_embd_head_k(il);
             const int64_t hk = hparams.n_head_kv(il);
             const int64_t hq = hparams.n_head(il);
             GGML_ASSERT(hparams.n_embd_head_v(il) == d && "cpca: K and V head dims must match");
             auto & c = cpca_layers[il];
-            auto mk3 = [&](const char * nm) { auto * t = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d, d, hk); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
-            auto mk2 = [&](const char * nm, int64_t h) { auto * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, d, h); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
+            auto mk3 = [&](const char * nm) { auto * t = ggml_new_tensor_3d(cctx, GGML_TYPE_F32, d, d, hk); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
+            auto mk2 = [&](const char * nm, int64_t h) { auto * t = ggml_new_tensor_2d(cctx, GGML_TYPE_F32, d, h); ggml_format_name(t, "cpca_%s_l%d", nm, il); return t; };
             c.q_rot = mk3("q_rot");  c.k_rot = mk3("k_rot");  c.k_unrot = mk3("k_unrot");
             c.v_rot = mk3("v_rot");  c.v_unrot = mk3("v_unrot");
             c.k_bias = mk2("k_bias", hk); c.k_mean = mk2("k_mean", hk);
@@ -329,6 +355,15 @@ llama_kv_cache::llama_kv_cache(
     }
 
     if (has_cpca) {
+        for (auto & [buft, cctx] : cpca_ctx_map) {
+            ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(cctx.get(), buft);
+            if (!buf) {
+                throw std::runtime_error("failed to allocate buffer for the cpca codebook");
+            }
+            LLAMA_LOG_INFO("%s: %10s cpca codebook buffer size = %8.2f MiB\n", __func__, ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0);
+            cpca_ctxs_bufs.emplace_back(std::move(cctx), buf);
+        }
+        cpca_ctx_map.clear();
         int n_set = 0;
         for (uint32_t il = 0; il < hparams.n_layer(); ++il) {
             if (map_layer_ids.find(il) == map_layer_ids.end()) {
diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index fa2b3d4..2b30f13 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -267,6 +267,7 @@ private:
     // env: LLAMA_ATTN_ROT_DISABLE
     bool attn_rot_k = false;
     std::vector<cpca_layer> cpca_layers;   // indexed by model layer, empty when no codebook
+    std::vector<std::pair<ggml_context_ptr, ggml_backend_buffer_ptr>> cpca_ctxs_bufs; // always allocated, unlike the cache in no_alloc mode
     bool has_cpca = false;
     bool attn_rot_v = false;
 
-- 
2.43.0

