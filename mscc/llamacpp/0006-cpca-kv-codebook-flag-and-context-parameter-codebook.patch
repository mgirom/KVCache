     model(model), hparams(hparams), v_trans(v_trans),
     n_seq_max(n_seq_max), n_stream(unified ? 1 : n_seq_max), n_pad(n_pad), n_swa(n_swa), swa_type(swa_type),
     other(static_cast<llama_kv_cache *>(mem_other)),
@@ -113,7 +115,9 @@ llama_kv_cache::llama_kv_cache(
     ggml_context * cpca_host = nullptr;
     gguf_context * cpca_gguf = nullptr;
     {
-        const char * cpca_path = getenv("LLAMA_KV_CODEBOOK");
+        // the context parameter wins; the environment variable remains as a fallback for
+        // harnesses that cannot pass parameters
+        const char * cpca_path = (kv_codebook && *kv_codebook) ? kv_codebook : getenv("LLAMA_KV_CODEBOOK");
         if (cpca_path && *cpca_path) {
             if (!(ggml_is_quantized(type_k) || ggml_is_quantized(type_v))) {
                 throw std::runtime_error("LLAMA_KV_CODEBOOK set but the KV cache is not quantised; the codebook replaces the rotation of a quantised cache");
@@ -123,6 +127,36 @@ llama_kv_cache::llama_kv_cache(
             if (!cpca_gguf) {
                 throw std::runtime_error(std::string("failed to read cpca codebook: ") + cpca_path);
             }
+            // bind the codebook to the model it was fitted on: architecture, name and
+            // geometry. Not cryptographic; it catches the realistic mistake, the wrong
+            // model, and refuses rather than degrading.
+            {
+                auto want_str = [&](const char * key) -> std::string {
+                    const int64_t k = gguf_find_key(cpca_gguf, key);
+                    return k < 0 ? std::string() : std::string(gguf_get_val_str(cpca_gguf, k));
+                };
+                auto want_u32 = [&](const char * key) -> int64_t {
+                    const int64_t k = gguf_find_key(cpca_gguf, key);
+                    return k < 0 ? -1 : (int64_t) gguf_get_val_u32(cpca_gguf, k);
+                };
+                const std::string cb_arch = want_str("cpca.model_arch");
+                const std::string my_arch = llm_arch_name(model.arch);
+                if (!cb_arch.empty() && cb_arch != my_arch) {
+                    throw std::runtime_error("cpca codebook was fitted on architecture '" + cb_arch + "', this model is '" + my_arch + "'");
+                }
+                char buf[256] = {0};
+                const int32_t nn = llama_model_meta_val_str(&model, "general.name", buf, sizeof(buf));
+                const std::string cb_name = want_str("cpca.model_name");
+                if (nn > 0 && !cb_name.empty() && cb_name != std::string(buf)) {
+                    throw std::runtime_error("cpca codebook was fitted on model '" + cb_name + "', this model is '" + std::string(buf) + "'");
+                }
+                const int64_t cb_layers = want_u32("cpca.n_layer"), cb_kv = want_u32("cpca.n_head_kv"), cb_hd = want_u32("cpca.head_dim");
+                if ((cb_layers >= 0 && cb_layers != (int64_t) hparams.n_layer()) ||
+                    (cb_kv     >= 0 && cb_kv     != (int64_t) hparams.n_head_kv()) ||
+                    (cb_hd     >= 0 && cb_hd     != (int64_t) hparams.n_embd_head_k())) {
+                    throw std::runtime_error("cpca codebook geometry does not match this model (layers / kv heads / head dim)");
+                }
+            }
             has_cpca = true;
             cpca_layers.resize(hparams.n_layer());
             LLAMA_LOG_WARN("%s: cpca codebook: %s (%d tensors) -- replacing the Hadamard rotation\n",
@@ -385,10 +419,20 @@ llama_kv_cache::llama_kv_cache(
                 if (ggml_nelements(src) != ggml_nelements(dst) || src->ne[0] != dst->ne[0] || src->ne[1] != dst->ne[1]) {
                     throw std::runtime_error(std::string("cpca codebook tensor has the wrong shape for this model: ") + name);
                 }
-                if (src->type != GGML_TYPE_F32) {
-                    throw std::runtime_error(std::string("cpca codebook tensor must be f32: ") + name);
+                std::vector<float> host(ggml_nelements(dst));
+                if (src->type == GGML_TYPE_F32) {
+                    memcpy(host.data(), src->data, ggml_nbytes(dst));
+                } else if (src->type == GGML_TYPE_F16) {
+                    ggml_fp16_to_fp32_row((const ggml_fp16_t *) src->data, host.data(), ggml_nelements(dst));
+                } else {
+                    throw std::runtime_error(std::string("cpca codebook tensor must be f32 or f16: ") + name);
+                }
+                for (float v : host) {
+                    if (!std::isfinite(v)) {
+                        throw std::runtime_error(std::string("cpca codebook tensor has a non-finite value: ") + name);
+                    }
                 }
-                ggml_backend_tensor_set(dst, src->data, 0, ggml_nbytes(dst));
+                ggml_backend_tensor_set(dst, host.data(), 0, ggml_nbytes(dst));
                 ++n_set;
             }
         }
